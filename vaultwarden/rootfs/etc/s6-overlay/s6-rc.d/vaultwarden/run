#!/command/execlineb -P

# =============================================================================
# s6-overlay service runner for Vaultwarden
# =============================================================================
# Reads HA add-on configuration from /data/options.json and launches vaultwarden
# with the appropriate environment variables.
# =============================================================================

with-contenv
bashio -c '
# Log prefix
log() { echo "[vaultwarden] $*"; }

# ---------------------------------------------------------------------------
# Read options from /data/options.json directly (more reliable than bashio
# in s6 context) and export as Vaultwarden environment variables.
# ---------------------------------------------------------------------------
OPTIONS_FILE="/data/options.json"

if [ -f "${OPTIONS_FILE}" ]; then
    # Parse JSON using jq (which is included in the HA base image)
    SIGNUPS_ALLOWED=$(jq -r ".signups_allowed // false" "${OPTIONS_FILE}")
    DOMAIN=$(jq -r ".domain // empty" "${OPTIONS_FILE}")
    ADMIN_TOKEN=$(jq -r ".admin_token // empty" "${OPTIONS_FILE}")
    DISABLE_ADMIN=$(jq -r ".disable_admin_panel // false" "${OPTIONS_FILE}")
else
    log "WARNING: ${OPTIONS_FILE} not found, using defaults"
    SIGNUPS_ALLOWED=false
    DOMAIN=""
    ADMIN_TOKEN=""
    DISABLE_ADMIN=false
fi

log "Configured signups_allowed=${SIGNUPS_ALLOWED}"

# ---------------------------------------------------------------------------
# Set environment variables for vaultwarden
# ---------------------------------------------------------------------------
export SIGNUPS_ALLOWED="${SIGNUPS_ALLOWED}"
export DATA_FOLDER="/data"
export WEB_VAULT_FOLDER="/web-vault"
export ROCKET_PORT=80
export ROCKET_ADDRESS="0.0.0.0"
export ROCKET_LOG="critical"
export LOG_FILE="/data/vaultwarden.log"

if [ -n "${DOMAIN}" ]; then
    export DOMAIN="${DOMAIN}"
    log "Domain set to ${DOMAIN}"
fi

if [ -n "${ADMIN_TOKEN}" ] && [ "${DISABLE_ADMIN}" != "true" ]; then
    export ADMIN_TOKEN="${ADMIN_TOKEN}"
    log "Admin panel enabled"
fi

# ---------------------------------------------------------------------------
# Ensure correct permissions
# ---------------------------------------------------------------------------
if [ -d "/data" ]; then
    chown -R vaultwarden:vaultwarden /data
    chmod 700 /data
fi

log "Starting vaultwarden with signups_allowed=${SIGNUPS_ALLOWED}..."

# ---------------------------------------------------------------------------
# Run vaultwarden as the vaultwarden user
# ---------------------------------------------------------------------------
exec s6-setuidgid vaultwarden /usr/local/bin/vaultwarden
'
